# -----------------------------------------------------------------------------
# Media-Tracker – Umgebungsvariablen
#
# Lokal:  diese Datei nach .env.local kopieren und ausfüllen (.env.local wird
#         nicht committet).
# Vercel: dieselben Namen unter Project → Settings → Environment Variables.
# Wie du an jeden Wert kommst, steht Schritt für Schritt in der README.
# -----------------------------------------------------------------------------

# --- Login -------------------------------------------------------------------
# Dein Passwort für die App (lang wählen, z.B. 4+ zufällige Wörter)
APP_PASSWORD=
# Zufallswert zum Signieren des Login-Cookies, erzeugen mit:  openssl rand -hex 32
AUTH_SECRET=

# --- Supabase (Datenbank) ----------------------------------------------------
# Project Settings → Data API → Project URL, z.B. https://abcdefgh.supabase.co
SUPABASE_URL=
# Project Settings → API Keys → Secret key (sb_secret_…)
# oder Legacy-Tab → service_role. NUR serverseitig, niemals veröffentlichen!
SUPABASE_SECRET_KEY=

# --- TMDB (Filme & Serien) ---------------------------------------------------
# themoviedb.org → Einstellungen → API → "API-Schlüssel" (v3) oder
# "API-Lesezugriffstoken" (v4) – beides funktioniert
TMDB_API_KEY=

# --- Telegram-Benachrichtigungen ---------------------------------------------
# Von @BotFather nach /newbot, Format 123456789:AA…
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID (Zahl), siehe README
TELEGRAM_CHAT_ID=

# --- Hintergrund-Job ---------------------------------------------------------
# Geheimes Token für /api/poll, erzeugen mit:  openssl rand -hex 32
# Muss identisch auch als GitHub-Actions-Secret POLL_SECRET hinterlegt werden.
POLL_SECRET=
